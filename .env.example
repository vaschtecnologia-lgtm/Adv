# ==========================================
# WONO ADVOCACIA - CONFIGURAÇÃO DE AMBIENTE
# ==========================================

# GEMINI_API_KEY: Chave de API do Google Gemini (para análise de andamentos e contratos)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# APP_URL: URL base da aplicação hospedada
APP_URL=

# ==========================================
# BANCO DE DADOS GRATUITO (OPCIONAL)
# ==========================================
# Opção 1: Firebase Firestore (Plano Spark Gratuito - 1GB + 50k leituras/dia)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opção 2: Supabase (Plano Gratuito - PostgreSQL 500MB + Auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

